# Copy to .env.local for local development. On Vercel, set the same names under
# Project → Settings → Environment Variables (Production + Preview).

# Supabase → Project Settings → API (or "Connect" → App Frameworks → Next.js).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The anon/public key. The newer "publishable" key (sb_publishable_...) also works here,
# or set it as NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY instead.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Not used by the app in this phase; reserved for future admin/server jobs.
# Never prefix with NEXT_PUBLIC_ and never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth is configured in Supabase, not here:
#   Supabase → Authentication → Sign In / Providers → Google (client ID + secret from Google Cloud).
# Only needed when running the local Supabase stack (`supabase start`), read by supabase/config.toml:
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Allowlist: who may enter the app is stored in the public.allowed_emails table, not in env.
# Add people in the Supabase SQL editor:
#   insert into public.allowed_emails (email, note) values ('person@yourdomain.com', 'Name');
