# Copy to .env.local for local development. On Vercel, set the same names under
# Project → Settings → Environment Variables (Production + Preview).

# Supabase → Project Settings → API (or "Connect" → App Frameworks → Next.js).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The anon/public key. The newer "publishable" key (sb_publishable_...) also works here,
# or set it as NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY instead.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Used only to deliver queued email (claim_email_outbox / complete_email_outbox), Slack
# messages and outbound webhooks (claim_integration_outbox / complete_integration_outbox), and by
# /api/cron/workflows (workflow_tick). Without it, rows stay "pending" in public.email_outbox and
# public.integration_outbox.
# Never prefix with NEXT_PUBLIC_ and never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# Email via Resend (https://resend.com). Leave RESEND_API_KEY or EMAIL_FROM empty to mock delivery:
# rows are marked "mocked" and the rendered subject is logged as [email:mocked] instead of sent.
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. "ALHC Projects <requests@yourdomain.com>".
EMAIL_FROM=
# Optional no-reply sender on the same verified domain, e.g. "no-reply@yourdomain.com" (or "Name <addr>").
# Every email that can't be answered by email comes from it and ends with "Do not reply to this email.";
# only responses to form submitters (Reply-To on EMAIL_REPLY_DOMAIN; see README) come from EMAIL_FROM.
# Empty = EMAIL_FROM for everything. The workspace's sender name goes in front of either address.
EMAIL_FROM_NOREPLY=

# Slack / outbound webhook rule actions. Webhook URLs and shared secrets are set per project in the app
# (Settings → Integrations) or per rule, never here. Set to "true" to mock delivery: rows are marked
# "mocked" and logged as [integration:mocked] with the redacted host instead of being POSTed.
INTEGRATIONS_MOCK=

# Shared secret for /api/cron/workflows. Vercel Cron sends it as "Authorization: Bearer <secret>"
# automatically when this variable is set. Without it the route refuses every request.
CRON_SECRET=

# Optional. Canonical origin for the public form link and iframe snippet shown in the form builder,
# and for task.url deep links in outbound webhook payloads, e.g. https://projects.example.com.
# Defaults to the request host when it is one of this app's own addresses (webhooks fall back to
# VERCEL_PROJECT_PRODUCTION_URL, else omit task.url). Set it in Vercel Production to the production URL.
NEXT_PUBLIC_APP_URL=

# Sign-in is email + password for now (Supabase → Authentication → Email provider, "Confirm email" on).
# Set to "true" to show "Continue with Google" once the Google provider below is configured.
AUTH_GOOGLE_ENABLED=

# Google OAuth is configured in Supabase, not here:
#   Supabase → Authentication → Sign In / Providers → Google (client ID + secret from Google Cloud).
# Only needed when running the local Supabase stack (`supabase start`), read by supabase/config.toml. The
# CLI loads env files from supabase/ and the repository root (e.g. a root .env.local or supabase/.env), not
# from apps/web — put these two there (or in your shell); apps/web/.env.local is read only by the app:
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Allowlist: who may enter the app is stored in the public.allowed_emails table, not in env.
# Add people in the Supabase SQL editor:
#   insert into public.allowed_emails (email, note) values ('person@yourdomain.com', 'Name');

# AI builder round 5 (experimental pilot, docs/MCP.md): the MCP endpoint (/api/mcp). Server only, never
# NEXT_PUBLIC_. Without both (and SUPABASE_SERVICE_ROLE_KEY) the endpoint answers 503.
#   ALHC_MCP_TOKEN_PEPPER  a random secret of at least 32 characters; personal access tokens are stored as
#                          HMAC-SHA256(pepper, token). Changing it invalidates every token.
#   SUPABASE_JWT_SECRET    the project's JWT secret (Supabase → Project Settings → API / JWT keys); the
#                          endpoint mints 5-minute tokens for the token's owner with it, so RLS runs as them.
ALHC_MCP_TOKEN_PEPPER=
SUPABASE_JWT_SECRET=
