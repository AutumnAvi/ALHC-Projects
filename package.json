{
  "name": "alhc-projects",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/core",
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @alhc/web --",
    "build": "npm run build --workspace @alhc/web --",
    "start": "npm run start --workspace @alhc/web --",
    "lint": "npm run lint --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm test --workspaces",
    "db:test": "bash supabase/tests/run.sh",
    "db:types": "supabase gen types typescript --linked --schema public > packages/core/src/supabase/database.types.ts"
  },
  "devDependencies": {
    "supabase": "^2.119.0"
  }
}
