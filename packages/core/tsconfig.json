{
  // The core package's own check. "WebWorker" brings the web platform (fetch, URL, Web Crypto, streams,
  // timers, console) without the DOM, and there are no Node types: window, document, HTMLElement,
  // localStorage, process, or Buffer in src/ fail here. WebWorker also declares a few things Node lacks
  // (self, XMLHttpRequest, indexedDB, …): tests/boundaries.test.ts allows only the web globals Node,
  // browsers, and webviews all have. The web app type-checks these files again with its own settings when
  // it imports them. tests/ has its own config (Node's test runner).
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ESNext", "WebWorker"],
    "types": [],
    "strict": true,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
