# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (the root and every workspace: apps/web, packages/core)
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js (apps/web)
.next/
out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase cli
supabase/.temp
supabase/.branches

# pdf.js worker copied at build time (apps/web/scripts/copy-pdf-worker.mjs)
apps/web/public/pdfjs/
